{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-tracker",
  "main": "src/index.tsx",
  "compatibility_date": "2025-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
